---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
---

<BaseLayout title="2026 CNC Light in the Forest Proposal">

  <main>

    <section class="project-detail proposal-title-section">
      <div class="top">
        <h1 class="studio-name">Greider Lightworks</h1>
      </div>
      <div class="project-text">
        <h1 class="proposal-main-title">Light Portals</h1>
        <h2 class="proposal-subtitle">2026 Proposal for <em>Light in the Forest</em></h2>
      </div>

      <div class="project-media full-width-video">
        <video controls preload="metadata" class="proposal-video">
          <source src="/images/cnc2026-mockup-sound.mov#t=0.1">
        </video>
        <p class="caption">Concept Mockup for 2026 Installation</p>
      </div>
    </section>

    <section class="project-detail proposal-header">
      <div class="project-text">
        <div class="action-bar">
          <a href="/images/Light Portal Proposal 2026.pdf" class="pdf-link" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            Download Proposal PDF
          </a>
          
          <a href="https://www.instagram.com/hermgreider" target="_blank" rel="noopener" class="social-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.058-1.69-.072-4.949-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            Follow our progress on Instagram
          </a>
        </div>
      </div>
    </section>

    <section class="team-signature-row">
      
      <div class="team-member">
        <div class="member-headshot-wrap">
          <img src="/images/bio_aaron_crop.jpg" alt="Aaron Greider" class="sig-img" />
        </div>
        <div class="member-info">
          <span class="member-role">Design</span>
          <h3>Aaron Greider</h3>
          <p>Graphic Designer and Front-End Developer. Specialist in environmental graphics, experiential systems, and translating complex concepts into visual narratives.</p>
          <a href="/aaron" class="view-work-link">View Portfolio →</a>
        </div>
      </div>

      <div class="team-member">
        <div class="member-headshot-wrap">
          <img src="/images/bio_herm_crop.jpg" alt="Herm Greider" class="sig-img" />
        </div>
        <div class="member-info">
          <span class="member-role">LED & Sound Electronics</span>
          <h3>Herm Greider</h3>
          <p>Retired Software Engineer. Lead developer for embedded systems, real-time sensor integration, and generative sound synthesis for Greider Lightworks installations.</p>
          <a href="/herm" class="view-work-link">View Projects →</a>
        </div>
      </div>

    </section>

  </main>
</BaseLayout>

<style is:global>
  /* Title & Layout */
  .proposal-main-title { font-size: clamp(2.5rem, 8vw, 3.5rem); margin-bottom: 0.5rem; font-weight: 800; color: #fff; }
  .proposal-subtitle { font-size: 1.1rem; color: #888; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 2rem; }
  .proposal-intro { font-size: 1.2rem; line-height: 1.6; max-width: 800px; color: #ccc; }
  .proposal-title-section { border: none !important; }

  /* Video */
  .proposal-video { width: 100%; max-height: 75vh; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); background: #000; }
  .caption { margin-top: 1rem; font-size: 0.9rem; color: #666; font-style: italic; text-align: center; }

  /* Action Bar Buttons */
  .action-bar { display: flex; gap: 1.5rem; align-items: center; margin-top: 2rem; flex-wrap: wrap; }

  .pdf-link {
    background: #fff; color: #000; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 700;
    display: flex; align-items: center; gap: 10px; transition: all 0.3s ease;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
  }
  .pdf-link:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(255, 255, 255, 0.3); }

  .social-item {
    display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; padding: 11px 22px;
    border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 6px; font-size: 0.9rem; font-weight: 500; transition: all 0.3s ease;
  }
  .social-item:hover { background: rgba(255, 255, 255, 0.05); border-color: #fff; transform: translateY(-2px); }

  /* Portfolio Grid */
  .portfolio-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin: 4rem 0 6rem; }
  
  .portfolio-card {
    background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; overflow: hidden;
    text-decoration: none; color: #fff; transition: all 0.3s ease;
  }
  .portfolio-card:hover { transform: translateY(-5px); border-color: rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.07); }

  .card-image img { width: 100%; height: 280px; object-fit: cover; filter: grayscale(20%); transition: filter 0.3s; }
  .portfolio-card:hover .card-image img { filter: grayscale(0%); }

  .card-content { padding: 1.5rem; }
  .role-badge { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 0.5rem; }
  .card-content h3 { margin: 0 0 0.75rem 0; font-size: 1.5rem; }
  .card-content p { font-size: 0.95rem; line-height: 1.5; color: #bbb; margin: 0; }

/* The Signature Row */
  .team-signature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin: 6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 4rem;
  }

  .team-member {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  /* Small, subtle circular headshots */
  .member-headshot-wrap {
    flex: 0 0 100px;
  }

  .sig-img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.4s ease;
  }

  .team-member:hover .sig-img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }

  /* Typography */
  .member-role {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #666;
    margin-bottom: 0.5rem;
  }

  .member-info h3 {
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    color: #fff;
  }

  .member-info p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #aaa;
    margin-bottom: 1.5rem;
  }

  .view-work-link {
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 2px;
    transition: border-color 0.3s;
  }

  .view-work-link:hover {
    border-color: #fff;
  }

  @media (max-width: 900px) {
    .team-signature-row { grid-template-columns: 1fr; gap: 3rem; }
  }

  @media (max-width: 768px) {
    .action-bar { flex-direction: column; align-items: stretch; }
    .pdf-link, .social-item { justify-content: center; }
  }
</style>