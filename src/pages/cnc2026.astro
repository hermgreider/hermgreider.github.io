---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
---

<BaseLayout title="2026 CNC Light in the Forest Proposal">

  <main class="below-fold">

    <section class="project-detail">
      <div class="project-media gallery-grid">
        <video controls="controls" preload="metadata" class="singlevideo">
          <source src="/images/herm/synth-sound.mp4#t=0.1">
        </video>
      </div>
    </section>

    <section class="project-detail bio-section">
      <div class="project-text">
        <div class="social-links">
          <a href="https://www.instagram.com/hermgreider" target="_blank" rel="noopener" class="social-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.058-1.69-.072-4.949-.072zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            Instagram
          </a>
        </div>
      </div>
      
      <div class="project-text">
        <a href="/">Proposal PDF</a>
      </div>

    </section>


    <section class="portfolio-row">
      <a href="/aaron" class="portfolio-card">
        <img src="images/bio_aaron_crop.jpg" alt="Aaron Portfolio" />
        <div class="card-content">
            <h3>Aaron Greider</h3>
            <p>Graphic Designer/Front-End Web Developer at Jungle Jim’s International Market. BS Communication Design 
              from UC DAAP 2022. Cincinnati Nature Center Member and new volunteer (2025!). Eagle Scout and native plant 
              enthusiast. Bane of honeysuckle.</p>
        </div>
      </a>

      <a href="/herm" class="portfolio-card">
        <img src="images/bio_herm_crop.jpg" alt="Herm Portfolio" />
        <div class="card-content">
            <h3>Herm Greider</h3>
            <p>Retired Software Developer with 40 years experience leading, designing, and coding all types of 
              software systems for defense and commercial applications. BS Computer Science, UC. MS CS Wright State. 
              Currently prototyping next ideas for Light Portals.</p>
        </div>
      </a>
    </section>

  </main>
</BaseLayout>

<style is:global>
  /* Use is:global to override the flex alignment of .project-detail for this specific section */
  
  /* Select the first project-detail (the bio section) */
  .below-fold > section.project-detail:first-of-type {
    align-items: flex-start; /* Aligns both text and image to the top */
    padding-top: 2rem;       /* Reduced padding at the top of the page */
  }

  /* Target the container for Aaron's image */
  .headshot-container {
    display: flex;
    justify-content: flex-start; /* Align image to the left of its container */
    margin-top: 1rem;            /* Slight gap from the very top border */
    flex: 0 0 auto;              /* Prevents the image container from growing/shrinking weirdly */
  }
  
  /* The actual image constraints */
  .headshot {
    width: 150px !important;     /* Much smaller diameter (reduced from 250px) */
    height: 150px !important;    /* Must match width for the circle shape */
    object-fit: cover;
    border-radius: 50%;         /* Maintains the circular headshot */
    border: 3px solid rgba(255, 255, 255, 0.1); /* Subtle border */
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);      /* Adds some depth */
  }

  /* Ensure the text block stays readable and aligned */
  .below-fold > section.project-detail:first-of-type .project-text {
    flex: 1; /* Allows text to take available space */
    padding-right: 2rem; /* Gap between text and image */
  }

  /* Responsive adjustment for mobile screens */
  @media (max-width: 768px) {
    .below-fold > section.project-detail:first-of-type {
      flex-direction: column-reverse; /* Stacks image above text on mobile */
      align-items: center;            /* Center aligns elements on mobile */
      text-align: center;
    }

    .headshot-container {
      justify-content: center;
      margin-top: 0;
      margin-bottom: 1rem; /* Gap between image and text when stacked */
    }

    .cv-details {
      display: inline-block; /* Helps center the list on mobile */
      text-align: left;
    }
  }

  /* Keep the rest of the standardized gallery/video styles you had */
  .cv-summary p {
    margin-bottom: 0.75rem;
  }

  .cv-details {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .cv-details li {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
    color: #ccc;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .gallery-grid img {
    width: 100%;
    height: 400px;
    object-fit: cover;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>